# Variáveis de ambiente — copie para .env e preencha (NÃO versione o .env).
# Estas variáveis pertencem ao BACKEND (Cloud Functions). Segredos do
# Mercado Pago NUNCA devem ir para o app Flutter.

# URL externa do Painel de Gestão (tela Gestão -> "Abrir painel de gestão").
GESTAO_PANEL_URL=https://painel.novaaliancaolinda.com.br

# Mercado Pago (usados apenas no servidor/Cloud Functions):
MERCADOPAGO_ACCESS_TOKEN=coloque-no-servidor-nunca-no-app
MERCADOPAGO_PUBLIC_KEY=chave-publica-do-checkout
MERCADOPAGO_WEBHOOK_SECRET=segredo-do-webhook
