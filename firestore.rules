rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// Firestore Rules — rede Nova Aliança (multi-igreja)
//
// Princípios inegociáveis:
//  1. Negar por padrão.
//  2. Autorização SEMPRE relativa a uma igreja: nasce do vínculo aprovado em
//     /igrejas/{igrejaId}/membros/{uid}. Selecionar unidade no cliente não
//     concede nada.
//  3. O cliente NUNCA escreve perfil, status, funcoes_admin, auditoria nem
//     status financeiro. Essas mutações são exclusivas das Cloud Functions
//     (Admin SDK), que ignoram estas regras e repetem a autorização.
//  4. super_admin vem de custom claim — nunca de documento gravável.
//  5. Nada é apagado para representar saída: inativa-se o vínculo.
//
// Espelha packages/nova_alianca_core/lib/src/capabilities.dart.
// ═══════════════════════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers base ──────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isDono(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Custom claim definida pelo backend. Ausente => false.
    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.super_admin == true;
    }

    // ── Vínculo com a unidade ─────────────────────────────────────────
    function vinculoPath(igrejaId) {
      return /databases/$(database)/documents/igrejas/$(igrejaId)/membros/$(request.auth.uid);
    }

    function temVinculo(igrejaId) {
      return isSignedIn() && exists(vinculoPath(igrejaId));
    }

    function vinculo(igrejaId) {
      return get(vinculoPath(igrejaId)).data;
    }

    // Único status que concede acesso.
    function isAprovadoNa(igrejaId) {
      return temVinculo(igrejaId) && vinculo(igrejaId).status == 'aprovado';
    }

    function perfilNa(igrejaId) {
      return vinculo(igrejaId).perfil;
    }

    function funcoesNa(igrejaId) {
      return vinculo(igrejaId).get('funcoes_admin', []);
    }

    // Grupo DERIVADO — nunca lido de um campo gravável.
    function isLiderancaMinisterial(igrejaId) {
      return isAprovadoNa(igrejaId)
        && perfilNa(igrejaId) in ['pastor', 'diacono', 'evangelista', 'lider'];
    }


    function temFuncao(igrejaId, funcao) {
      return isAprovadoNa(igrejaId) && funcao in funcoesNa(igrejaId);
    }

    // ── Capacidades (espelham capabilities.dart) ──────────────────────
    function canReadFinance(igrejaId) {
      return isSuperAdmin()
        || isLiderancaMinisterial(igrejaId)
        || temFuncao(igrejaId, 'tesoureiro');
    }

    function canManageContent(igrejaId) {
      return isSuperAdmin()
        || isLiderancaMinisterial(igrejaId)
        || temFuncao(igrejaId, 'editor');
    }

    function canModeratePrayer(igrejaId) {
      return isSuperAdmin()
        || isLiderancaMinisterial(igrejaId)
        || temFuncao(igrejaId, 'moderador_oracao');
    }

    function canReadAudit(igrejaId) {
      return isSuperAdmin() || isLiderancaMinisterial(igrejaId);
    }

    // Membro aprovado da unidade: base para ler conteúdo restrito.
    function isMembroDa(igrejaId) {
      return isAprovadoNa(igrejaId);
    }

    // Conteúdo marcado como público é legível por qualquer autenticado
    // (inclui visitante anônimo). Exige o campo booleano `publico == true`,
    // de modo que a consulta do cliente precise filtrar por ele.
    function isPublico() {
      return resource.data.get('publico', false) == true;
    }

    function podeLerConteudo(igrejaId) {
      return isPublico() || isMembroDa(igrejaId) || canManageContent(igrejaId);
    }

    // ═══════════════════════════════════════════════════════════════════
    // PERFIL GLOBAL DO USUÁRIO
    // Identidade e dados pessoais. NENHUMA permissão mora aqui.
    // ═══════════════════════════════════════════════════════════════════
    match /usuarios/{uid} {
      // Somente o dono e o super_admin. A liderança enxerga as pessoas pela
      // subcoleção de membros da PRÓPRIA unidade, nunca por esta coleção
      // global (era o vazamento entre igrejas da versão anterior).
      allow read: if isDono(uid) || isSuperAdmin();

      allow create: if isDono(uid)
                    && request.resource.data.keys().hasOnly([
                         'nome', 'email', 'telefone', 'foto_url',
                         'data_nascimento', 'igreja_principal_id',
                         'criado_em', 'atualizado_em', 'dados_pessoais'
                       ]);

      // O dono edita os próprios dados cadastrais. Campos de autorização não
      // existem aqui; igreja_principal_id só muda pelo servidor (vincular a
      // outra unidade é uma operação auditada).
      allow update: if isDono(uid)
                    && !request.resource.data.diff(resource.data)
                          .affectedKeys()
                          .hasAny(['igreja_principal_id', 'criado_em']);

      allow delete: if false;

      match /notificacoes/{notificacaoId} {
        allow read: if isDono(uid);
        // Marcar como lida — e nada além disso.
        allow update: if isDono(uid)
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['lida']);
        allow delete: if isDono(uid);
        allow create: if false; // somente servidor
      }

      match /tokens_dispositivo/{tokenId} {
        allow read, create, update, delete: if isDono(uid);
      }
    }

    // ═══════════════════════════════════════════════════════════════════
    // IGREJAS
    // ═══════════════════════════════════════════════════════════════════
    match /igrejas/{igrejaId} {
      // Catálogo público: o app precisa listar unidades antes do login.
      allow read: if true;

      // Criar/remover unidade é exclusivo do super_admin, via Function.
      allow create, delete: if false;
      // Configuração institucional: somente servidor (pastor/super_admin
      // autorizados dentro da Function, com auditoria).
      allow update: if false;

      // ── Vínculos ────────────────────────────────────────────────────
      match /membros/{uid} {
        // A pessoa lê o próprio vínculo; quem administra a unidade lê todos.
        allow read: if isDono(uid)
                    || isSuperAdmin()
                    || isLiderancaMinisterial(igrejaId)
                    || temFuncao(igrejaId, 'tesoureiro')
                    || temFuncao(igrejaId, 'editor')
                    || temFuncao(igrejaId, 'moderador_oracao');

        // Autocadastro: só o próprio uid, sempre PENDENTE, sempre membro e
        // sempre sem funções administrativas. Fecha a autopromoção na criação.
        allow create: if isDono(uid)
                      && request.resource.data.status == 'pendente'
                      && request.resource.data.perfil == 'membro'
                      && request.resource.data.get('funcoes_admin', []).size() == 0;

        // Toda mutação de perfil/status/funções é exclusiva do servidor.
        // Isto fecha D.1 (autopromoção e promoção arbitrária).
        allow update: if false;

        // Saída é inativação auditada, nunca exclusão física.
        allow delete: if false;
      }

      // ── Conteúdo (avisos, eventos, campanhas, ministérios, devocionais) ──
      match /avisos/{avisoId} {
        allow read: if podeLerConteudo(igrejaId);
        allow write: if canManageContent(igrejaId);
      }

      match /eventos/{eventoId} {
        allow read: if podeLerConteudo(igrejaId);
        allow write: if canManageContent(igrejaId);

        match /participantes/{uid} {
          allow read: if isMembroDa(igrejaId) || canManageContent(igrejaId);
          allow write: if isDono(uid) && isMembroDa(igrejaId);
        }
      }

      match /campanhas/{campanhaId} {
        allow read: if podeLerConteudo(igrejaId);
        allow write: if canManageContent(igrejaId);
      }

      match /ministerios/{ministerioId} {
        allow read: if podeLerConteudo(igrejaId);
        allow write: if canManageContent(igrejaId);
      }

      match /devocionais/{devocionalId} {
        allow read: if podeLerConteudo(igrejaId);
        allow write: if canManageContent(igrejaId);
      }

      match /interesses_ministerio/{interesseId} {
        allow create: if isMembroDa(igrejaId)
                      && request.resource.data.usuario_id == request.auth.uid;
        allow read, update, delete: if canManageContent(igrejaId);
      }

      // ── Pedidos de oração ───────────────────────────────────────────
      match /pedidos_oracao/{pedidoId} {
        allow read: if canModeratePrayer(igrejaId)
                    || (isSignedIn() && resource.data.autor_id == request.auth.uid)
                    || (isMembroDa(igrejaId)
                        && resource.data.privado == false
                        && resource.data.aprovado == true);

        // Aberto a qualquer autenticado (inclui visitante anônimo), mas o
        // pedido entra SEMPRE como não aprovado — a moderação decide.
        allow create: if isSignedIn()
                      && request.resource.data.autor_id == request.auth.uid
                      && request.resource.data.aprovado == false;

        allow update: if canModeratePrayer(igrejaId)
                      || (isSignedIn()
                          && resource.data.autor_id == request.auth.uid
                          && !request.resource.data.diff(resource.data)
                                .affectedKeys().hasAny(['aprovado', 'oram_count', 'oram_por']))
                      // Reação "Estou orando": incremento de exatamente 1 e
                      // inclusão do PRÓPRIO uid, uma única vez. Fecha D.6.
                      || (isMembroDa(igrejaId)
                          && request.resource.data.diff(resource.data)
                               .affectedKeys().hasOnly(['oram_count', 'oram_por'])
                          && request.resource.data.oram_count
                               == resource.data.get('oram_count', 0) + 1
                          && !(request.auth.uid in resource.data.get('oram_por', []))
                          && request.resource.data.oram_por
                               == resource.data.get('oram_por', []).concat([request.auth.uid]));

        // Recusar um pedido é marcá-lo, não apagá-lo (feito pelo servidor).
        allow delete: if false;
      }

      // ── Transações ──────────────────────────────────────────────────
      match /transacoes/{transacaoId} {
        // Acesso financeiro por unidade: liderança ministerial OU tesoureiro.
        // Editor e moderador não entram. O dono vê as próprias contribuições.
        allow read: if canReadFinance(igrejaId)
                    || (isSignedIn() && resource.data.usuario_id == request.auth.uid);

        // O cliente jamais escreve status financeiro. Toda criação passa pela
        // Cloud Function, que carrega a credencial da unidade correta.
        allow create, update, delete: if false;
      }

      // ── Auditoria ───────────────────────────────────────────────────
      match /auditoria/{registroId} {
        allow read: if canReadAudit(igrejaId);
        // Fecha D.2: nenhum cliente cria, altera ou apaga auditoria.
        allow create, update, delete: if false;
      }

      // ── Configurações da unidade ────────────────────────────────────
      match /configuracoes/{docId} {
        allow read: if isSignedIn();
        allow write: if false; // somente servidor
      }
    }

    // ═══════════════════════════════════════════════════════════════════
    // CAMINHOS GLOBAIS ANTIGOS — NEGADOS
    //
    // O app não foi lançado; a migração é direta. Estes caminhos existiram
    // na v1.3.0 e são explicitamente negados para que nenhum cliente
    // desatualizado continue lendo ou gravando fora do escopo de igreja.
    // Os DADOS não são apagados — apenas o acesso do cliente é fechado.
    // ═══════════════════════════════════════════════════════════════════
    match /avisos/{documento=**}                { allow read, write: if false; }
    match /eventos/{documento=**}               { allow read, write: if false; }
    match /campanhas/{documento=**}             { allow read, write: if false; }
    match /ministerios/{documento=**}           { allow read, write: if false; }
    match /devocionais/{documento=**}           { allow read, write: if false; }
    match /pedidos_oracao/{documento=**}        { allow read, write: if false; }
    match /transacoes/{documento=**}            { allow read, write: if false; }
    match /auditoria/{documento=**}             { allow read, write: if false; }
    match /notificacoes/{documento=**}          { allow read, write: if false; }
    match /tokens_dispositivo/{documento=**}    { allow read, write: if false; }
    match /interesses_ministerio/{documento=**} { allow read, write: if false; }
    match /igreja/{documento=**}                { allow read, write: if false; }
    match /configuracoes/{documento=**}         { allow read, write: if false; }
  }
}
