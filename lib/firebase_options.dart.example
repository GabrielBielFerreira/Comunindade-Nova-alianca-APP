// EXEMPLO — NÃO É USADO EM BUILD.
//
// O arquivo real `lib/firebase_options.dart` é GERADO automaticamente por:
//
//     dart pub global activate flutterfire_cli
//     flutterfire configure
//
// Ele contém as chaves públicas do projeto Firebase (apiKey, appId, etc.).
// Essas chaves são identificadores públicos do app cliente — a segurança real
// vem das Security Rules (firestore.rules / storage.rules) e do backend.
//
// Após gerar, em lib/main.dart:
//   import 'firebase_options.dart';
//   await Firebase.initializeApp(options: DefaultFirebaseOptions.currentPlatform);
